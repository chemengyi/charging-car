<launch>
  <arg name="state_decision_param_path" default="$(find-pkg-share state_decision)/config/state_decision.param.yaml" />
  <arg name="task_planner_param_path" default="$(find-pkg-share task_planner)/config/task_planner.param.yaml" />
  <node pkg="task_planner" exec="task_planner" name="task_planner" output="screen">
    <param from="$(var state_decision_param_path)"/>
    <param name="param_path" value="$(var state_decision_param_path)" />
    <param name="task_planner_param_path" value="$(var task_planner_param_path)" />
  </node>
</launch>
